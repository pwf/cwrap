#!/usr/bin/env bash
set -euo pipefail

CWRAP_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cwrap"

# ---------------------------------------------------------------------------
# Arg parsing
# ---------------------------------------------------------------------------
DO_BUILD=0
BUILD_NO_CACHE=0
YOLO=0
INSTANCE=""
AGENT=""
CLI_DIRS=()
PASSTHROUGH=()
SESSION_INDEX=-1
SESSION_MODE=""
SESSION_HAS_ID=0
SESSION_COUNT=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        help|--help|-h)
            cat <<'EOF'
Usage:
  cwrap build [-u] [-i <instance>]         build image from instances/<name>/Containerfile
  cwrap [--agent claude|codex] [-i <instance>] [dir...]  run the selected agent
  cwrap [options] [dir...] -r|--resume [id]             resume a session (picker without id)
  cwrap [options] [dir...] -c|--continue [id]           continue (Codex: resume --last without id)
  cwrap [options] [dir...] -- <args>                   pass native agent args unchanged

Options:
  -i, --instance <name>  use a specific instance (default: default_instance from config)
  --agent <name>         claude or codex (CLI > instance default_agent > global > claude)
  -u, --upgrade          (build) rebuild image from scratch, ignoring cache
  --yolo                Claude: --dangerously-skip-permissions
                        Codex: --dangerously-bypass-approvals-and-sandbox (no inner sandbox!)
  -h, --help             show this help

Config: ~/.config/cwrap/
  config                     global config (default_instance=<name>, default_agent=claude|codex)
  instances/<name>/
    Containerfile            per-instance image definition
    cwrap.conf               CWRAP_DIRS=(...), optional default_agent=claude|codex
    home/                    mounted as /home/cwrap inside container
EOF
            exit 0
            ;;
        build)
            DO_BUILD=1
            shift
            ;;
        -u|--upgrade)
            BUILD_NO_CACHE=1
            shift
            ;;
        --agent)
            [[ $# -lt 2 ]] && { echo "cwrap: --agent requires an argument" >&2; exit 1; }
            AGENT="$2"
            case "$AGENT" in
                claude|codex) ;;
                *) echo "cwrap: invalid agent: $AGENT (expected claude or codex)" >&2; exit 1 ;;
            esac
            shift 2
            ;;
        --yolo)
            YOLO=1
            shift
            ;;
        -i|--instance)
            [[ $# -lt 2 ]] && { echo "cwrap: -i requires an argument" >&2; exit 1; }
            INSTANCE="$2"
            shift 2
            ;;
        --)
            shift
            PASSTHROUGH+=("$@")
            break
            ;;
        --resume|-r)
            SESSION_COUNT=$((SESSION_COUNT + 1))
            SESSION_INDEX=${#PASSTHROUGH[@]}
            SESSION_MODE=resume
            PASSTHROUGH+=("--resume")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                PASSTHROUGH+=("$1")
                shift
            fi
            ;;
        --continue|-c)
            SESSION_COUNT=$((SESSION_COUNT + 1))
            SESSION_INDEX=${#PASSTHROUGH[@]}
            SESSION_MODE=continue
            SESSION_HAS_ID=0
            PASSTHROUGH+=("--continue")
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                SESSION_HAS_ID=1
                PASSTHROUGH+=("$1")
                shift
            fi
            ;;
        -*)
            echo "cwrap: unknown option: $1" >&2
            exit 1
            ;;
        *)
            CLI_DIRS+=("$1")
            shift
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
if ! command -v podman &>/dev/null; then
    echo "cwrap: podman not found" >&2
    exit 1
fi
RUNTIME=podman

# ---------------------------------------------------------------------------
# Source global config (sets default_instance)
# ---------------------------------------------------------------------------
if [[ -f "$CWRAP_DIR/config" ]]; then
    # shellcheck source=/dev/null
    source "$CWRAP_DIR/config"
fi

# Resolve instance
if [[ -z "$INSTANCE" ]]; then
    INSTANCE="${default_instance:-}"
fi
if [[ -z "$INSTANCE" ]]; then
    echo "cwrap: no instance specified and no default_instance in $CWRAP_DIR/config" >&2
    exit 1
fi

# Validate instance name
if [[ "$INSTANCE" =~ \.\. ]] || [[ ! "$INSTANCE" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
    echo "cwrap: invalid instance name: $INSTANCE" >&2
    exit 1
fi

INSTANCE_DIR="$CWRAP_DIR/instances/$INSTANCE"
INSTANCE_HOME_DIR="$CWRAP_DIR/instances/$INSTANCE/home"

# ---------------------------------------------------------------------------
# build
# ---------------------------------------------------------------------------
if [[ "$DO_BUILD" -eq 1 ]]; then
    mkdir -p "$INSTANCE_DIR"
    BUILD_FLAGS=()
    [[ "$BUILD_NO_CACHE" -eq 1 ]] && BUILD_FLAGS+=(--no-cache)
    exec "$RUNTIME" build "${BUILD_FLAGS[@]}" -t "cwrap-${INSTANCE}:latest" -f "$INSTANCE_DIR/Containerfile" "$INSTANCE_DIR"
fi

# ---------------------------------------------------------------------------
# run
# ---------------------------------------------------------------------------

# Source instance config (sets CWRAP_DIRS)
CWRAP_DIRS=()
if [[ -f "$INSTANCE_DIR/cwrap.conf" ]]; then
    # shellcheck source=/dev/null
    source "$INSTANCE_DIR/cwrap.conf"
fi

# Resolve agent after instance config; the explicit CLI selection wins.
AGENT="${AGENT:-${default_agent:-claude}}"
case "$AGENT" in
    claude|codex) ;;
    *) echo "cwrap: invalid agent: $AGENT (expected claude or codex)" >&2; exit 1 ;;
esac

if [[ "$AGENT" == codex && "$SESSION_COUNT" -gt 1 ]]; then
    echo "cwrap: codex accepts only one session selector" >&2
    exit 1
fi

# Merge CLI dirs
for d in "${CLI_DIRS[@]}"; do
    CWRAP_DIRS+=("$d")
done

# Check image exists
IMAGE="cwrap-${INSTANCE}:latest"
if ! "$RUNTIME" image exists "$IMAGE" 2>/dev/null; then
    echo "cwrap: image $IMAGE not found — run: cwrap build -i $INSTANCE" >&2
    exit 1
fi

mkdir -p "$INSTANCE_HOME_DIR/.config/claude"
VOL_FLAGS=(-v "$INSTANCE_HOME_DIR:/home/cwrap:z")

# Build --add-dir flags for either agent and extra volume mounts
ADD_DIR_FLAGS=()
declare -A _seen_dirs=()
for dir in "${CWRAP_DIRS[@]}"; do
    dir="$(realpath -m "$dir")"
    [[ -n "${_seen_dirs[$dir]+x}" ]] && continue
    _seen_dirs[$dir]=1
    VOL_FLAGS+=(-v "$dir:$dir:z")
    ADD_DIR_FLAGS+=(--add-dir "$dir")
done

# Pass through terminal detection, then the selected agent's environment
ENV_FLAGS=()
for var in TERM COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION; do
    [[ -n "${!var+x}" ]] && ENV_FLAGS+=(-e "$var=${!var}")
done
# Agent-specific host environment allowlist. Never inherit host auth/config homes.
if [[ "$AGENT" == claude ]]; then
    while IFS='=' read -r key _; do
        ENV_FLAGS+=(-e "$key=${!key}")
    done < <(env | grep '^ANTHROPIC_')
else
    for var in OPENAI_API_KEY; do
        [[ -n "${!var+x}" ]] && ENV_FLAGS+=(-e "$var=${!var}")
    done
fi

# Forward Wayland socket so chromium can render on the host display
if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    _wayland_sock="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
    if [[ -S "$_wayland_sock" ]]; then
        ENV_FLAGS+=(-e "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" -e "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR")
        VOL_FLAGS+=(-v "$_wayland_sock:$_wayland_sock")
    fi
fi

YOLO_FLAGS=()
if [[ "$AGENT" == codex && "$SESSION_INDEX" -ge 0 ]]; then
    PASSTHROUGH[$SESSION_INDEX]=resume
    if [[ "$SESSION_MODE" == continue && "$SESSION_HAS_ID" -eq 0 ]]; then
        PASSTHROUGH=("${PASSTHROUGH[@]:0:$((SESSION_INDEX + 1))}" --last "${PASSTHROUGH[@]:$((SESSION_INDEX + 1))}")
    fi
fi
if [[ "$YOLO" -eq 1 ]]; then
    if [[ "$AGENT" == codex ]]; then
        YOLO_FLAGS+=(--dangerously-bypass-approvals-and-sandbox)
    else
        YOLO_FLAGS+=(--dangerously-skip-permissions)
    fi
elif [[ "$AGENT" == codex ]]; then
    # Permit --add-dir roots without overriding network or approval settings.
    YOLO_FLAGS+=(--sandbox workspace-write)
fi

if [[ ${#PASSTHROUGH[@]} -gt 0 ]]; then
    CMD_ARGS=("$AGENT" "${ADD_DIR_FLAGS[@]}" "${YOLO_FLAGS[@]}" "${PASSTHROUGH[@]}")
else
    CMD_ARGS=("$AGENT" "${ADD_DIR_FLAGS[@]}" "${YOLO_FLAGS[@]}")
fi

WORKDIR_FLAGS=()
if [[ ${#CLI_DIRS[@]} -gt 0 ]]; then
    WORKDIR_FLAGS=(-w "$(realpath -m "${CLI_DIRS[0]}")")
fi

# Load .claude-env from the primary working directory into the container environment
if [[ ${#CLI_DIRS[@]} -gt 0 ]]; then
    _env_file="$(realpath -m "${CLI_DIRS[0]}")/.cwrap.env"
    if [[ -f "$_env_file" ]]; then
        # shellcheck source=/dev/null
        source "$_env_file"
        while IFS= read -r key; do
            [[ -n "${!key+x}" ]] && ENV_FLAGS+=(-e "$key=${!key}")
        done < <(grep -v '^[[:space:]]*#' "$_env_file" | grep '=' | sed 's/^export[[:space:]]*//' | cut -d= -f1 | grep -E '^[A-Za-z_][A-Za-z0-9_]*$')
    fi
fi

exec "$RUNTIME" run --rm -it --userns=keep-id \
    "${ENV_FLAGS[@]}" \
    "${VOL_FLAGS[@]}" \
    "${WORKDIR_FLAGS[@]}" \
    "$IMAGE" \
    "${CMD_ARGS[@]}"
